{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mcplink",
  "version": "0.1.0",
  "identifier": "io.mcplink.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mcplink",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620,
        "backgroundColor": "#f8f9f7"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/mcplink"
    ],
    "category": "DeveloperTool",
    "shortDescription": "个人桌面 MCP 接入管理器",
    "resources": [
      "../LICENSE",
      "../THIRD_PARTY_NOTICES.txt"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
