{
  "name": "mcplink",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "check": "node scripts/prepare-sidecar.mjs --debug && cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "desktop": "node scripts/prepare-sidecar.mjs --debug && tauri dev",
    "bundle": "node scripts/bundle.mjs",
    "release:macos": "node scripts/release-macos.mjs",
    "tauri": "tauri",
    "release:windows": "node scripts/release-windows.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "json5": "2.2.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "yaml": "2.9.1"
  },
  "description": "Unified MCP gateway and MCP-to-CLI with managed authentication",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sw897/mcplink.git"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
